{% extends 'admin/base.html.twig' %}

{% block title %}Cars · Admin{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Cars <span class="text-muted fs-6">({{ cars|length }})</span></h1>
        <a href="{{ path('admin_car_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New car
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 90px;">Photo</th>
                        <th>Car</th>
                        <th>Plate</th>
                        <th>Category</th>
                        <th>Fuel / gearbox</th>
                        <th class="text-end">Price / day</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for car in cars %}
                    <tr>
                        <td>
                            <img src="{{ car.image ? asset('uploads/cars/' ~ car.image) : asset('images/car-placeholder.png') }}"
                                 alt="{{ car.brand }} {{ car.model }}" class="rounded" style="width: 72px; height: 48px; object-fit: cover;">
                        </td>
                        <td>
                            <div class="fw-semibold">{{ car.brand }} {{ car.model }}</div>
                            <div class="small text-muted">{{ car.year }} · {{ car.seats }} seats</div>
                        </td>
                        <td><code>{{ car.plateNumber }}</code></td>
                        <td>{{ car.category.name }}</td>
                        <td class="small">{{ car.fuelType.value|capitalize }} · {{ car.transmission.value|capitalize }}</td>
                        <td class="text-end fw-semibold">€{{ car.pricePerDay|number_format(2) }}</td>
                        <td class="text-center">
                            {% if car.isAvailable %}
                                <span class="badge rounded-pill text-bg-success">Available</span>
                            {% else %}
                                <span class="badge rounded-pill text-bg-secondary">Unavailable</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a href="{{ path('app_car_show', {id: car.id}) }}" class="btn btn-sm btn-outline-secondary" title="Public page">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('admin_car_edit', {id: car.id}) }}" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                {{ include('admin/car/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No cars yet.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
