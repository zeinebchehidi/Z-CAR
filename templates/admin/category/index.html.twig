{% extends 'admin/base.html.twig' %}

{% block title %}Categories · Admin{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Categories</h1>
        <a href="{{ path('admin_category_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New category
        </a>
    </div>

    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th class="text-center">Cars</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for category in categories %}
                <tr>
                    <td class="fw-semibold">{{ category.name }}</td>
                    <td class="text-muted">{{ category.description|default('—') }}</td>
                    <td class="text-center">
                        <span class="badge rounded-pill text-bg-light">{{ category.cars|length }}</span>
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            <a href="{{ path('admin_category_edit', {id: category.id}) }}" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            {{ include('admin/category/_delete_form.html.twig') }}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">No categories yet.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
