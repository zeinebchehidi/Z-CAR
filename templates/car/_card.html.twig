{# One car card, used on the home page and the /cars list.
   Usage: {{ include('car/_card.html.twig', { car: car, rating: averageRating }) }} (rating is optional) #}
{% import '_macros.html.twig' as ui %}

<div class="card h-100 shadow-sm">
    <img src="{{ car.image ? asset('uploads/cars/' ~ car.image) : asset('images/car-placeholder.png') }}"
         class="card-img-top car-card-img" alt="{{ car.brand }} {{ car.model }}">
    <div class="card-body d-flex flex-column gap-2">
        <h5 class="card-title mb-0">
            {{ car.brand }} {{ car.model }} <span class="text-muted fw-normal">· {{ car.year }}</span>
        </h5>
        <div class="d-flex flex-wrap gap-3 small text-muted">
            <span><i class="bi bi-fuel-pump"></i> {{ car.fuelType.value|capitalize }}</span>
            <span><i class="bi bi-people"></i> {{ car.seats }}</span>
            <span><i class="bi bi-gear"></i> {{ car.transmission.value|capitalize }}</span>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-auto">
            <div><span class="fs-4 fw-bold">€{{ car.pricePerDay|number_format(0) }}</span> <span class="text-muted">/ day</span></div>
            {{ ui.stars(rating ?? null) }}
        </div>
        <a href="{{ path('app_car_show', { id: car.id }) }}" class="btn btn-outline-primary">Details</a>
    </div>
</div>
