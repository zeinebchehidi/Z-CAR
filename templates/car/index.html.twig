{% extends 'base.html.twig' %}

{% block title %}Our cars - Car Rental{% endblock %}

{% block body %}
    <div class="row g-4">
        {# Filters sidebar #}
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3"><i class="bi bi-funnel"></i> Filters</h2>
                    {{ form_start(searchForm) }}
                        {{ form_row(searchForm.category) }}
                        {{ form_row(searchForm.fuelType) }}
                        {{ form_row(searchForm.transmission) }}
                        <div class="row g-2">
                            <div class="col-6">{{ form_row(searchForm.minPrice) }}</div>
                            <div class="col-6">{{ form_row(searchForm.maxPrice) }}</div>
                        </div>
                        {{ form_row(searchForm.start, { attr: { min: 'now'|date('Y-m-d') } }) }}
                        {{ form_row(searchForm.end, { attr: { min: 'now'|date('Y-m-d') } }) }}
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Apply</button>
                            <a href="{{ path('app_car_index') }}" class="btn btn-outline-secondary">Reset</a>
                        </div>
                    {{ form_end(searchForm) }}
                </div>
            </div>
        </div>

        {# Car grid #}
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-baseline mb-3">
                <h1 class="h3 mb-0">Our cars</h1>
                <span class="text-muted">{{ cars|length }} car{{ cars|length == 1 ? '' : 's' }} found</span>
            </div>

            {% if cars is empty %}
                <div class="alert alert-light border">
                    No car matches your filters. <a href="{{ path('app_car_index') }}">Reset the filters</a>
                </div>
            {% else %}
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                    {% for car in cars %}
                        <div class="col">{{ include('car/_card.html.twig', { car: car, rating: ratings[car.id] ?? null }) }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
