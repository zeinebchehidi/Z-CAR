{% extends 'base.html.twig' %}

{% block title %}Register - Car Rental{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4"><i class="bi bi-person-plus text-primary"></i> Create an account</h1>

                    {{ form_errors(registrationForm) }}

                    {{ form_start(registrationForm) }}
                        <div class="row">
                            <div class="col-sm-6">{{ form_row(registrationForm.firstName) }}</div>
                            <div class="col-sm-6">{{ form_row(registrationForm.lastName) }}</div>
                        </div>
                        {{ form_row(registrationForm.email) }}
                        {{ form_row(registrationForm.plainPassword, { help: 'At least 6 characters.' }) }}

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Register</button>
                        </div>
                    {{ form_end(registrationForm) }}

                    <p class="text-center text-muted mt-4 mb-0">
                        Already have an account? <a href="{{ path('app_login') }}">Log in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
